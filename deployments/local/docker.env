# Host-local Java runtime configuration. Docker Compose provides dependencies only.
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=DRAGON
DB_USER=DRAGON
DB_PASSWORD=DRAGON
DB_PASS=DRAGON
DB_NAME=PAYMENT_GATEWAY

DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_SEEDER=true

SECRET_KEY=yantopedia
DB_URL=postgres://DRAGON:DRAGON@localhost:5432/PAYMENT_GATEWAY
KAFKA_BROKERS=localhost:9092

APP_ENV=dev
APP_LOGGER=development

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight
REDIS_URL=redis://:dragon_knight@localhost:6379
