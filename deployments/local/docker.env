QUARKUS_REDIS_HOSTS=redis://:dragon_knight@localhost:6379,redis://:dragon_knight@localhost:6380,redis://:dragon_knight@localhost:6381,redis://:dragon_knight@localhost:6382,redis://:dragon_knight@localhost:6383,redis://:dragon_knight@localhost:6384
