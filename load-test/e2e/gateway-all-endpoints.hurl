{"merchantId":{{merchant_id}},"userId":{{user_id}},"totalPrice":100,"items":[{"productId":0,"quantity":1,"price":100}],"shipping":{"alamat":"A","provinsi":"P","kota":"K","courier":"JNE","shippingMethod":"REG","shippingCost":1000,"negara":"ID"}}
HTTP 400
[Asserts]
jsonpath "$.status" == "error"
jsonpath "$.message" contains "positive integer"

POST {{base_url}}/api/orders/update/{{order_id}}
Authorization: Bearer {{user_token}}
Content-Type: application/json

{"userId":{{user_id}},"totalPrice":100,"items":[],"shipping":{"shippingId":0,"orderId":{{order_id}},"alamat":"A","provinsi":"P","kota":"K","courier":"JNE","shippingMethod":"REG","shippingCost":1000,"negara":"ID"}}
HTTP 400
[Asserts]
jsonpath "$.status" == "error"
jsonpath "$.message" contains "positive integer"

POST {{base_url}}/api/merchant-details/create
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{"merchantId":0,"displayName":"X","coverImageUrl":"https://x.test/a.png","logoUrl":"https://x.test/l.png","shortDescription":"x","websiteUrl":"https://x.test"}
HTTP 400
[Asserts]
jsonpath "$.status" == "error"
jsonpath "$.message" contains "positive integer"
