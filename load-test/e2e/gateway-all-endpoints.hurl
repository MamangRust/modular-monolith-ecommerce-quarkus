# Generated by load-test/generate-hurl-e2e.py
# Run through load-test/run-hurl-e2e.sh; do not run this file with missing variables.

GET {{base_url}}/q/health/ready
HTTP 200
[Asserts]
jsonpath "$.status" == "UP"

POST {{base_url}}/api/auth/login
Content-Type: application/json

{"email":"{{email}}","password":"{{password}}"}
HTTP 200
[Captures]
user_token: jsonpath "$.data.accessToken"
refresh_token: jsonpath "$.data.refreshToken"
[Asserts]
jsonpath "$.status" == "success"
jsonpath "$.data.accessToken" exists

GET {{base_url}}/api/auth/me?userId={{user_id}}
Authorization: Bearer {{user_token}}
HTTP 200
[Asserts]
jsonpath "$.data.id" == {{user_id}}

POST {{base_url}}/api/auth/refresh
Content-Type: application/json

{"refreshToken":"{{refresh_token}}"}
HTTP 200
[Asserts]
jsonpath "$.status" == "success"

# ---- Auth: full register flow (gateway -> auth -> user create -> role resolve) ----
# Register is intentionally covered: it exercises the whole internal gRPC chain
# (auth calls user service create, which resolves roles via the role service).
POST {{base_url}}/api/auth/register
Content-Type: application/json

{"firstname":"Hurl","lastname":"E2E","email":"{{marker_lower}}@example.test","password":"HurlE2EPass!2026"}
HTTP 201
[Asserts]
jsonpath "$.status" == "success"

# Round-trip: the newly registered user must be able to log in.
POST {{base_url}}/api/auth/login
Content-Type: application/json

{"email":"{{marker_lower}}@example.test","password":"HurlE2EPass!2026"}
HTTP 200
[Asserts]
jsonpath "$.status" == "success"
jsonpath "$.data.accessToken" exists

